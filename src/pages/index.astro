---
import Layout from "../layouts/Layout.astro";
import "../styles/styles.css";

// C5 forbids instructions anywhere, so there is no prose on this page and there
// is not going to be any. Everything below is either the game, the game's name,
// or an accessible name a screen reader needs to operate it at all.
//
// The opening scene is in the served HTML, in CSS, on purpose: a slab hanging
// off-centre above a slab. The rules and the motion may wait for JavaScript ---
// that is the brief --- but the *invitation* may not, because the page gets one
// chance to make the first move obvious and a blank rectangle has spent it.
---

<Layout
  title="One Button Tower"
  description="A small browser game: an isometric tower, one button, and twenty storeys of slabs that get narrower the further you get."
>
  <div class="app">
    <header class="topbar">
      <h1 class="wordmark">One Button Tower</h1>
      <nav aria-label="Primary">
        <a class="nav-link" href="./">New tower</a>
      </nav>
    </header>

    <div class="stage" data-core-output>
      <canvas class="stage-canvas" data-stage></canvas>

      <div class="opening" aria-hidden="true">
        <div class="opening-slab opening-slab-held"></div>
        <div class="opening-slab opening-slab-base"></div>
      </div>

      <div class="hud">
        <p class="score" data-score>0</p>
        <p class="best" data-best></p>
      </div>

      <div class="verdict" data-verdict hidden role="status">
        <p class="verdict-word" data-verdict-word></p>
        <p class="verdict-score" data-verdict-score></p>
        <span class="verdict-again" aria-hidden="true">&#8635;</span>
      </div>

      {/*
        One control for all three input paths. A real <button> so mouse, touch
        and keyboard arrive from the browser rather than from three handlers,
        and full-bleed so a phone player is not aiming at a 44px target while
        timing a moving slab.

        data-code declares the binding for both Chrome sensors to read, rather
        than either of them naming a letter of the keyboard: the day a game is
        rebound from WASD to the arrows, a written-down table becomes a sensor
        pressing keys bound to nothing and reporting a dead page.

        Space is the declared binding --- it is the game's key, the one the
        design is about. main.ts also accepts Enter, because a keyboard user who
        has tabbed to a button expects Enter to work it; that is an
        accessibility alias rather than a second control, so it is not declared
        here. check:render presses Enter on the marked control anyway.
      */}
      <button
        class="tap"
        type="button"
        data-core-interaction
        data-code="Space"
        aria-label="Drop the slab"></button>
    </div>
  </div>

  <script src="../scripts/main.ts"></script>
</Layout>
