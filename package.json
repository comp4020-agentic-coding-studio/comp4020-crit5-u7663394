{
  "name": "comp4020-static-prototype",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "check": "pnpm typecheck && pnpm build && oxlint --ignore-path .gitignore --deny-warnings && stylelint \"**/*.css\" --ignore-path .gitignore --allow-empty-input && vitest run",
    "check:evidence": "node scripts/check-evidence.ts",
    "check:render": "pnpm build && node scripts/render-check.mjs",
    "check:play": "pnpm build && node scripts/play-check.mjs",
    "shots": "pnpm build && node scripts/render-check.mjs --shots .shots",
    "test": "vitest run"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.0.0",
    "astro": "^7.1.6",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.9.0"
}
